# Runtime
# Run Chromium in headed mode on a virtual X display. This stays invisible to the operator
# while preserving the browser mode Google Flow/gflow currently validates most reliably.
DISPLAY=:98
FLOW_BRIDGE_HEADLESS=0
FLOW_BRIDGE_MCP_TRANSPORT=streamable-http
FLOW_BRIDGE_MCP_HOST=127.0.0.1
FLOW_BRIDGE_MCP_PORT=8765
FLOW_BRIDGE_MCP_PATH=/mcp

# Persistent state. Choose private operator-owned directories.
FLOW_BRIDGE_HOME=/path/to/private/flow-bridge/runtime
GFLOW_CLI_HOME=/path/to/private/flow-bridge/gflow-cli

# Optional explicit Chromium-family executable.
# FLOW_BRIDGE_BROWSER_EXECUTABLE=/path/to/chrome

# Only enable when the host kernel blocks Chromium's native sandbox.
# Prefer OS/container isolation when this is required.
FLOW_BRIDGE_BROWSER_NO_SANDBOX=0
